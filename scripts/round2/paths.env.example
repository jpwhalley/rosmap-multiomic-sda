# Copy, fill in and point G_ROS_CONFIG at the copy (or export the variables). Unset variables use the defaults in config.py.
G_ROS_ROSMAP_DIR=/path/to/rosmap
G_ROS_SEAAD_DIR=/path/to/seaad/dlpfc
G_ROS_DEPOSIT_DIR=/path/to/synapse_v3
G_ROS_REFERENCES_DIR=/path/to/references
G_ROS_SEQUENCES_DIR=/path/to/sequences
G_ROS_ARCHIVE_DIR=/path/to/version1_results
G_ROS_CLINICAL_PATH=/path/to/ROSMAP_clinical.csv
G_ROS_RESULTS_DIR=/path/to/results
G_ROS_PRIVATE_DIR=/path/to/private
G_ROS_THREADS=2
